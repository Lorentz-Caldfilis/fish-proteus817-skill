include README.md README.zh-CN.md LICENSE LICENSE.zh-CN.md
include THIRD_PARTY_NOTICES.md CONTRIBUTING.md SECURITY.md CHANGELOG.md PUBLICATION.md
include public-release.json MANIFEST.in
include .gitattributes .gitignore .github/workflows/ci.yml
include .github/ISSUE_TEMPLATE/*.yml
include PUBLIC_MANIFEST.json
include docs/DEVELOPMENT.md docs/VALIDATION.md docs/SKILL_FORMAT.md
include docs/GENERIC_API.md
include docs/RELEASE_STATUS.md
recursive-include docs/design *.md
recursive-include skills/fish-proteus817 *.md *.txt
recursive-include tests *.py
include tools/acceptance.py tools/bootstrap_nasm.py tools/demo_task_100khz.txt
include tools/dsh_cli_gate.py tools/dsh_headless.py tools/dsh_install_skill.py
include tools/dsh_project_tool.mjs tools/public_release.py
include tools/design_gate.py tools/dsh_design_tool.mjs tools/vendor_provenance.py
include tools/desktop_gate.py tools/dsh_desktop_tool.mjs tools/dsh_desktop_bootstrap.mjs
include tools/dsh_install_desktop.py
include tools/demo_task_generic.txt
include tools/generic_structure_acceptance.py
include tools/generic_native_acceptance.py
include tools/build_stm32_demo.py
recursive-include examples/stm32_gpio_follow *.c *.S *.ld *.md
recursive-include fish_proteus/_vendor/proteus_auto *.upstream *.md *.json
prune evidence
prune reference
prune .local
prune .tools
prune .work
prune .dsh
prune .venv
global-exclude __pycache__ *.py[cod]
